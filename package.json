{
  "name": "calendar-agent-implementation",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test:core": "tsc --noEmit -p tsconfig.core.json",
    "test:calendar-core": "tsx scripts/test-calendar-core.ts",
    "test:repo": "node scripts/test-repository.mjs",
    "verify:local": "npm run test:repo && npm run typecheck && npm run test:core && npm run test:calendar-core",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "dev:clean": "npm run clean && next dev -p 3000",
    "diagnose:planner": "tsx scripts/diagnose-planner.ts",
    "diagnose:planner:full": "tsx scripts/diagnose-planner.ts --full",
    "diagnose:config": "tsx scripts/diagnose-config.ts",
    "diagnose:provider": "tsx scripts/diagnose-provider.ts",
    "acceptance:agent": "tsx scripts/acceptance-agent.ts",
    "acceptance:agent:full": "tsx scripts/acceptance-agent.ts --full"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@next/env": "^15.5.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tsx": "^4.20.5",
    "typescript": "^5.8.0"
  }
}
